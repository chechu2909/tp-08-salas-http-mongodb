<section class="card">
  <h2>Registrar Nueva Reserva</h2>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert-error" style="color: #721c24; background-color: #f8d7da; padding: 10px; margin-bottom: 15px; border-radius: 4px;">
      <%= error %>
    </div>
  <% } %>

  <form action="/reservas" method="POST" novalidate>
    <div class="form-group">
      <label for="estudiante">Nombre del Estudiante:</label>
      <input type="text" id="estudiante" name="estudiante" value="<%= typeof valores !== 'undefined' && valores.estudiante ? valores.estudiante : '' %>" required>
    </div>

    <div class="form-group">
      <label for="sala">Sala:</label>
      <select id="sala" name="sala" required>
        <option value="">-- Seleccionar Sala --</option>
        <% const salasPermitidas = ['Sala Norte', 'Sala Sur', 'Sala Multimedia']; %>
        <% salasPermitidas.forEach(s => { %>
          <option value="<%= s %>" <%= typeof valores !== 'undefined' && valores.sala === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>

<div class="mb-3">
  <label for="email" class="form-label">Correo Electrónico:</label>
  <input type="email" class="form-control" id="email" name="email" required placeholder="ejemplo@correo.com">
</div>

    <div class="form-group">
      <label for="fecha">Fecha (YYYY-MM-DD):</label>
      <input type="text" id="fecha" name="fecha" placeholder="Ej. 2026-10-15" value="<%= typeof valores !== 'undefined' && valores.fecha ? valores.fecha : '' %>" required>
    </div>

    <div class="form-group">
      <label for="turno">Turno:</label>
      <select id="turno" name="turno" required>
        <option value="">-- Seleccionar Turno --</option>
        <% const turnosPermitidos = ['Mañana', 'Tarde', 'Noche']; %>
        <% turnosPermitidos.forEach(t => { %>
          <option value="<%= t %>" <%= typeof valores !== 'undefined' && valores.turno === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="personas">Cantidad de Personas (1 a 6):</label>
      <input type="number" id="personas" name="personas" min="1" max="6" value="<%= typeof valores !== 'undefined' && valores.personas ? valores.personas : '' %>" required>
    </div>

    <button type="submit" class="btn">Confirmar Reserva</button>
  </form>

  <p style="margin-top: 20px;">
    <a href="/reservas" style="color: inherit; text-decoration: underline;">&larr; Volver al listado</a>
  </p>
</section>